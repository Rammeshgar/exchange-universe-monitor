# Use your own SMTP account, verified sender, and recipient list.
# Copy this file to email-alerts.env before entering any values.
MAIL_SERVER_ADDRESS=
MAIL_SERVER_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_ADDRESS=
MAIL_RECIPIENT_ADDRESS=

# Failures and reminders are allowed from the start hour through the end hour, exclusive.
# Identical start and end hours enable delivery all day.
ALERT_TIMEZONE=UTC
ALERT_START_HOUR=4
ALERT_END_HOUR=17
MAX_EMAIL_ATTACHMENT_MB=20
